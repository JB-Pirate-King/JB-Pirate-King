ais_ids_pi/build
ais_ids_pi/po

# LangSmith / 환경변수
.env

# ── ml/ ────────────────────────────────────────────────────────────────
# 데이터 (실제 경로: D:\ais_data\)
ml/data/

# 비교 결과 (실제 경로: D:\ais_output\)
ml/output/

# 모델 파일 — train_benchmark.py 직접 실행 시 ml/ 루트에 생성될 수 있음
# (pipeline.py --base_dir 사용 시에는 D:\ais_models\ 로 저장)
ml/*.onnx
ml/*.json
# config/ 로 이동된 설정 — 시크릿(pipeline_config/google_credentials/notify_config) 무시,
# 추적 대상(example/fe_state)만 negation 으로 되살림. negation 은 ignore 패턴 뒤에 와야 함.
ml/config/*.json
!ml/config/fe_state.json
!ml/config/pipeline_config.example.json
ml/threshold*.txt
ml/eval_result_*.txt

# 전처리 중 생성되는 로그/임시 CSV
ml/*.csv

# PyTorch 체크포인트 (학습 중 임시 저장)
ml/*.pt
ml/*.pth

# 시각화 출력 (matplotlib 등)
ml/**/*.png
ml/**/*.jpg
ml/**/*.pdf

aivdm_gen/*.csv

# 런타임 생성 파일
ais_ids_alerts.log
*.log

# 임시 테스트 파일 (루트의 _tmp_* 패턴)
_tmp_*
ais_skip_log.csv
preprocess_meta.json

# MLflow 로컬 실행 데이터
mlruns/

# 모델 디렉토리 (실제 경로: D:\ais_models\)
ais_models/

# 파이프라인 작업용 임시 출력 (FE JSON/txt 리포트, 모델 export) — repo-local, 커밋 제외
ml/.pipeline_tmp/
ml/logs/
ml/deploy/**/*.tar.gz
!ml/pipeline_langgraph.png

# 빌드 아티팩트
*.tar.gz

# 시퀀스 캐시 파일
*.train.pkl
*.holdout.pkl

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# Claude Code 설정
.claude/

# 민감한 설정 파일
ml/pipeline_config.json
ml/google_credentials.json

# caveman-compress backups
*.original.md

ml/.baseline_diag*

# reco 생성 동적 후보
ml/dynamic_candidates.py
